{
  "protocol": "aethor-text-v1",
  "profile": "bench",
  "lines": [
    {
      "name": "numbered_hello",
      "request": "1 hello\n",
      "response": "ok 1 hello protocol=aethor-text-v1 fw=sim-1 profile=bench dof=7 boot=1234 watchdog_ms=1000"
    },
    {
      "name": "manual_state",
      "request": "show state\r\n",
      "response": "ok 0 show state state=unaligned aligned=0 enabled=00 moving=0 active=0 fault=none"
    },
    {
      "name": "normalized_case_and_spaces",
      "request": "7   PING\n",
      "response": "ok 7 ping state=unaligned enabled=00 boot=1234"
    },
    {
      "name": "bad_character",
      "request": "show\tstate\n",
      "response": "error 0 parse code=bad_line"
    }
  ],
  "byte_stream_cases": [
    {
      "name": "fragmented_hello",
      "chunks_ascii": ["1 hel", "lo\n"],
      "responses": ["ok 1 hello protocol=aethor-text-v1 fw=sim-1 profile=bench dof=7 boot=1234 watchdog_ms=1000"]
    },
    {
      "name": "concatenated_queries",
      "chunks_ascii": ["show state\nping\n"],
      "response_prefixes": ["ok 0 show state ", "ok 0 ping "]
    }
  ],
  "bench_move_build_cases": [
    {
      "name": "single_motor_one_shot_move",
      "request_id": 50,
      "motors": [1],
      "positions_deg": [90],
      "speeds_deg_s": [30],
      "request": "50 bench move 1 position=90 speed=30"
    },
    {
      "name": "multi_motor_one_to_one_move",
      "request_id": 51,
      "motors": [1, 3],
      "positions_deg": [90, -45],
      "speeds_deg_s": [30, 20],
      "request": "51 bench move 1,3 position=90,-45 speed=30,20"
    },
    {
      "name": "tiny_plain_decimal_move",
      "request_id": 53,
      "motors": [1],
      "positions_deg": [1e-10],
      "speeds_deg_s": [1e-10],
      "request": "53 bench move 1 position=0.0000000001 speed=0.0000000001"
    }
  ],
  "bench_move_invalid_cases": [
    {
      "name": "position_count_mismatch",
      "request_id": 52,
      "motors": [1, 3],
      "positions_deg": [90],
      "speeds_deg_s": [30, 20],
      "firmware_request": "52 bench move 1,3 position=90 speed=30,20",
      "firmware_response": "error 52 bench move code=count_mismatch field=position"
    }
  ],
  "bench_move_terminal_cases": [
    {
      "name": "completed_move",
      "request_id": 50,
      "line": "done 50 bench move result=completed elapsed_ms=3200 motors=05",
      "result": "completed",
      "elapsed_ms": 3200,
      "motor_mask": 5
    },
    {
      "name": "failed_move",
      "request_id": 50,
      "line": "done 50 bench move result=failed stage=motion code=stale_feedback motor=3",
      "result": "failed",
      "stage": "motion",
      "code": "stale_feedback",
      "motor": 3
    },
    {
      "name": "cancelled_move",
      "request_id": 50,
      "line": "done 50 bench move result=cancelled",
      "result": "cancelled"
    },
    {
      "name": "stopped_move",
      "request_id": 50,
      "line": "done 50 bench move result=stopped",
      "result": "stopped"
    }
  ],
  "bench_move_request_sequences": [
    {
      "name": "accepted_request_replay",
      "requests": [
        "62 bench move 3,1 position=-45,90 speed=20,30",
        "62 bench move 3,1 position=-45,90 speed=20,30"
      ],
      "responses": [
        "ok 62 bench move accepted=1",
        "ok 62 bench move accepted=1"
      ]
    },
    {
      "name": "request_id_conflict",
      "requests": [
        "62 bench move 3,1 position=-45,90 speed=20,30",
        "62 bench move 3,1 position=-44,90 speed=20,30"
      ],
      "responses": [
        "ok 62 bench move accepted=1",
        "error 62 bench move code=request_conflict"
      ]
    }
  ]
}
