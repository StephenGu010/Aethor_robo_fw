    assert(strcmp(lv_label_get_text(view.page.rows[1]), "-180.0") == 0);
    assert(strcmp(lv_label_get_text(view.page.rows[2]), "1.0") == 0);
    model.draft.delta_rad = -model.draft.delta_rad;
    model.snapshot.motors[6].position_max_rad = 12.5f / 19.2032f;
    model.focus = 5U;
    save_page(directory, "303_pos_flange_driver_blocked");
    assert(strstr(view.page.row_text[5], "驱动范围不符") != NULL);
    model.snapshot.motors[6].position_max_rad = 256.0f / 19.2032f;
