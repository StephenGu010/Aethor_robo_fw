    assert(strstr(view.page.row_text[1], "--") != NULL);
    model.snapshot.pos_load.peak_torque_nm = 999.999f;
    model.snapshot.pos_load.peak_error_rad = debug_ui_degrees_to_radians(180.0f);
    model.snapshot.pos_load.peak_mos_c = 999.9f;
    model.snapshot.pos_load.peak_rotor_c = -999.9f;
    model.snapshot.pos_load.samples = 4294967295UL;
    model.snapshot.pos_load.last_recovery_ms = 4294967295UL;
    model.snapshot.pos_load.max_recovery_ms = 4294967295UL;
    model.pos_load_result_detail = 1U;
    save_page(directory, "233_pos_peak_boundaries");
    model.pos_load_result_detail = 0U;
    model.snapshot.pos_load.stopped = 0U;
    model.completion_seen = 0U;
    save_page(directory, "234_pos_terminal_waiting");
