    assert(strstr(view.page.row_text[5], "停止") != NULL);
    assert(strcmp(lv_label_get_text(view.page.rows[3]), "已停止") == 0);
    model.snapshot.pos_load.stopped = 1U;
    model.snapshot.pos_load.disabled_confirmed = 0U;
    save_page(directory, "231_pos_stopped_disable_unknown");
    assert(strstr(view.page.row_text[6], "未确认") != NULL);
    model.snapshot.pos_load.peak_torque_nm = NAN;
