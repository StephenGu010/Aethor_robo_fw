    assert(strstr(view.page.footer_text, "STOP") != NULL);
    assert(strstr(view.page.row_text[6], "STOP") != NULL);
    assert(strstr(view.page.row_text[5], "未确认") != NULL);
    model.stop_latch_state = DEBUG_UI_STOP_LATCH_NONE;
    model.completion_seen = 1U;
    model.completion.operation = DEBUG_UI_OPERATION_POS_LOAD_TEST;
    model.completion.disabled_confirmed = 0U;
    model.completion.motor_mask = 4U;
    model.selected_motor = 2U;
    save_page(directory, "301_pos_cleanup_result_check");
    assert(strstr(view.page.footer_text, "STOP") != NULL);
    assert(strstr(view.page.row_text[6], "STOP") != NULL);
    assert(strstr(view.page.row_text[5], "未确认") != NULL);
    assert(!model.outgoing_ready && !model.stop_ready);
    simulated_data();
    model.pos_load_flow = model.snapshot.pos_load_enabled = 1U;
    model.selected_motor = 6U;
    model.page = DEBUG_UI_PAGE_POS_LOAD_SETUP;
    model.draft.operation = DEBUG_UI_OPERATION_POS_LOAD_TEST;
    model.draft.requested_mode = DEBUG_UI_MODE_POS_VEL;
    model.draft.target_motor_id = 7U;
    model.draft.hold_duration_ms = 5000U;
    model.draft.delta_rad = debug_ui_degrees_to_radians(-180.0f) * (44.8f / 19.2032f) * (1.0f - 4.0f * FLT_EPSILON);
    model.draft.speed_rad_s = debug_ui_degrees_to_radians(1.0f) * (44.8f / 19.2032f);
    model.snapshot.motors[6].pos_load_output_per_flange = 44.8f / 19.2032f;
    model.snapshot.motors[6].ranges_verified = 1U;
