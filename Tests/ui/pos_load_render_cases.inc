/** @file pos_load_render_cases.inc
 * @brief Production LVGL all-POS layout, glyph and report provenance tests, synthetic data only.
 */

/** @brief Verify the independent POS page has visible editable parameters and no dynamic objects. */
static void render_pos_load_scenarios(const char *directory)
{
    simulated_data();
    model.pos_load_flow = 1U;
    model.snapshot.pos_load_enabled = 1U;
    model.reason = DEBUG_UI_REASON_NONE;
    model.snapshot.target_motor_id = 1U;
    model.page = DEBUG_UI_PAGE_POS_LOAD_SETUP;
    model.draft.operation = DEBUG_UI_OPERATION_POS_LOAD_TEST;
    model.draft.requested_mode = DEBUG_UI_MODE_POS_VEL;
    model.draft.target_motor_id = 1U;
    model.draft.reference_generation = model.snapshot.motors[0].reference_generation;
    model.draft.delta_rad = debug_ui_degrees_to_radians(-1.0f);
    model.draft.speed_rad_s = debug_ui_degrees_to_radians(1.0f);
    model.draft.hold_duration_ms = 60000U;
    model.focus = 0U;
    save_page(directory, "210_pos_load_setup");
    assert(view.page.static_art.panel_count == 6U && view.page.static_art.icon_count == 6U);
    assert(lv_obj_get_style_text_font(view.page.rows[1], 0) == &ui_font_numeric_28);
    {
        static const char *const names[] = {"220_pos_focus_angle", "221_pos_focus_speed", "222_pos_focus_time",
            "223_pos_focus_record", "224_pos_focus_start", "225_pos_focus_control"};
        unsigned focus;
        for (focus = 1U; focus < 7U; ++focus) {
            model.focus = (uint8_t)focus;
            save_page(directory, names[focus - 1U]);
            assert(view.page.static_art.panel_count == 6U);
            assert(view.page.static_art.panels[focus - 1U].selected);
            assert(lv_color_to32(lv_obj_get_style_text_color(view.page.rows[focus], 0)) == lv_color_to32(lv_color_black()));
        }
    }
    model.focus = 0U;
    assert(strstr(view.page.row_text[0], "ID1") != NULL);
    assert(strstr(view.page.row_text[1], "-1.0") != NULL);
    assert(strstr(view.page.row_text[3], "60") != NULL);
    model.draft.delta_rad = debug_ui_degrees_to_radians(-180.0f);
    model.draft.speed_rad_s = debug_ui_degrees_to_radians(999.9f);
    model.focus = 1U;
    save_page(directory, "226_pos_parameters_large");
    model.draft.delta_rad = debug_ui_degrees_to_radians(-0.1f);
    model.draft.speed_rad_s = debug_ui_degrees_to_radians(0.1f);
    model.draft.hold_duration_ms = 1000U;
    model.focus = 3U;
    save_page(directory, "227_pos_parameters_minimum");
    model.draft.delta_rad = debug_ui_degrees_to_radians(-1.0f);
    model.draft.speed_rad_s = debug_ui_degrees_to_radians(1.0f);
    model.draft.hold_duration_ms = 60000U;
    model.focus = 0U;
    model.snapshot.pos_load_enabled = 0U;
    save_page(directory, "219_pos_load_default_locked");
    assert(strstr(view.page.row_text[5], "锁止") != NULL);
    model.snapshot.pos_load_enabled = 1U;
    model.page = DEBUG_UI_PAGE_POS_LOAD_NUMBER; model.edit_field = 2U;
    model.pos_digit_cursor = 3U; model.pos_digit_value = 10U;
    save_page(directory, "211_pos_load_number");
    model.edit_field = 1U; model.pos_digit_negative = 1U; model.pos_digit_value = 1800U;
    model.pos_digit_cursor = 0U;
    save_page(directory, "251_pos_digit_sign");
    assert(strstr(lv_label_get_text(view.page.rows[1]), "-180.0") != NULL);
    model.pos_digit_cursor = 1U;
    save_page(directory, "252_pos_digit_hundreds");
    assert(view.page.static_art.panel_count == 2U);
    model.pos_digit_cursor = 4U;
    save_page(directory, "253_pos_digit_tenths");
    model.edit_field = 3U; model.pos_digit_value = 60U; model.pos_digit_cursor = 2U;
    save_page(directory, "254_pos_digit_seconds");
    assert(!strcmp(lv_label_get_text(view.page.rows[1]), "60"));
    model.reviewed = model.draft; model.page = DEBUG_UI_PAGE_REVIEW;
    save_page(directory, "212_pos_load_review");
    model.review_released = 1U;
    save_page(directory, "228_pos_review_released");
    model.review_released = 0U;
    model.submitted = model.reviewed;
    model.submitted.identity.origin = DEBUG_UI_ORIGIN_LOCAL_UI;
    model.submitted.identity.epoch = model.snapshot.epoch;
    model.submitted.identity.request_id = 700U;
    model.submitted.created_at_us = model.snapshot.timestamp_us;
    model.snapshot.pos_load.identity = model.submitted.identity;
